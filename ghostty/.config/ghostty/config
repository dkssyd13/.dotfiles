# Theme
# - macOS: iterm2like 적용
# - Linux + omarchy: 아래 config-file이 동적으로 덮어쓰기
# - Linux + omarchy 없음: tokyo-night 폴백
theme = iterm2like
# theme = iTerm2 Default
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"

# Font
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 18

# Window
background = 000000
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat
background-opacity = 0.9
background-blur = true
background-blur-radius = 60
macos-titlebar-style = hidden
# macOS: 왼쪽 Option은 터미널 Alt/Meta로 전달하고 오른쪽 Option은 특수문자 입력용으로 유지
macos-option-as-alt = left

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# macOS: Cmd+숫자 → ESC+숫자(M-숫자) 전송 → tmux window 전환
# (Linux/omarchy에선 Super+숫자를 Hyprland가 워크스페이스 전환에 먼저 가로채므로 무영향)
keybind = super+physical:one=text:\x1b1
keybind = super+one=text:\x1b1
keybind = super+physical:two=text:\x1b2
keybind = super+two=text:\x1b2
keybind = super+physical:three=text:\x1b3
keybind = super+three=text:\x1b3
keybind = super+physical:four=text:\x1b4
keybind = super+four=text:\x1b4
keybind = super+physical:five=text:\x1b5
keybind = super+five=text:\x1b5
keybind = super+physical:six=text:\x1b6
keybind = super+six=text:\x1b6
keybind = super+physical:seven=text:\x1b7
keybind = super+seven=text:\x1b7
keybind = super+physical:eight=text:\x1b8
keybind = super+eight=text:\x1b8
keybind = super+physical:nine=text:\x1b9
keybind = super+nine=text:\x1b9

# macOS: Cmd+B → ESC+b(Alt/Meta+B) 전송
keybind = super+b=esc:b

# Copy selected text to the system clipboard
copy-on-select = clipboard

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
