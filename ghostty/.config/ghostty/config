# Theme
# - macOS: iterm2like 적용
# - Linux + omarchy: 아래 config-file이 동적으로 덮어쓰기
# - Linux + omarchy 없음: tokyo-night 폴백
# theme = iterm2like
# theme = iTerm2 Default
theme = Catppuccin Mocha
# Omarchy 3 path, then Omarchy 4 (the later include wins if both exist)
config-file = ?"~/.config/omarchy/current/theme/ghostty.conf"
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font (family and size are per-OS, see os/*.conf)
font-style = Regular

# Window
# background = 000000
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Copy selected text to the system clipboard
copy-on-select = clipboard

# Slightly slower trackpad scrolling (precision); mouse wheels (discrete) keep
# Ghostty's default of 3. A single value would apply to both and make wheels
# about 3x slower.
mouse-scroll-multiplier = precision:0.95,discrete:3

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# OS-specific settings. os/current.conf is a per-machine link to os/macos.conf or os/linux.conf.
config-file = ?"os/current.conf"

# Machine-specific overrides (e.g. font-size for this monitor). Untracked; loaded last so it wins.
config-file = ?"local.conf"
