# Herdr runtime files — only config.toml and scripts are managed
herdr/.config/herdr/*
!herdr/.config/herdr/config.toml
!herdr/.config/herdr/*.sh

# Claude Code synced skills — auto-downloaded from claude.ai, not managed here
claude/.claude/skills/synced/

# Neovim on Omarchy: symlink to the current Omarchy theme, created at startup
nvim/.config/nvim/lua/plugins/theme.lua
