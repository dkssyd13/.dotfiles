{
  "cleanupPeriodDays": 99999,
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Read(.env*)",
      "Edit(.env*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "course-practice-problems": "off",
    "paper-scout": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {},
  "language": "Korean",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "arxiv.org",
        "*.arxiv.org",
        "twitter.com",
        "x.com",
        "openaccess.thecvf.com",
        "openreview.net",
        "papers.nips.cc",
        "proceedings.mlr.press",
        "proceedings.neurips.cc",
        "paperswithcode.com"
      ]
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754138233856
  },
  "model": "claude-fable-5[1m]"
}
