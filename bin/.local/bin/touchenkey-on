#!/usr/bin/env bash
# Start the TouchEn nxKey daemon again (needed by Korean banking sites).
label=com.raon.touchen.nxkey

sudo launchctl enable "system/$label"
sudo launchctl bootstrap system "/Library/LaunchDaemons/$label.plist" 2>/dev/null

for _ in 1 2 3 4 5; do
  pgrep -u root -f 'TouchEn nxKey/TEK_Daemon' >/dev/null && { echo "TouchEn nxKey on"; exit 0; }
  sleep 1
done
echo "TouchEn nxKey did not start" >&2
exit 1
